PUID=1000
PGID=1000
# Local SSD: prometheus, loki and grafana data
MONITORING_DATA_PATH=/path/to/local/ssd/monitoring

GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://grafana.your-domain.com
AUTHENTIK_BASE_URL=https://auth.your-domain.com
GRAFANA_OAUTH_CLIENT_ID=from-authentik
GRAFANA_OAUTH_CLIENT_SECRET=from-authentik
GRAFANA_RENDERER_TOKEN=random-string
NTFY_IP=192.0.2.14
NTFY_ADMIN_TOKEN=your-ntfy-token

# Prometheus targets (JSON lists)
NODE_EXPORTER_TARGETS=["192.0.2.11:9100"]
CADVISOR_TARGETS=["192.0.2.11:8080"]
OPNSENSE_EXPORTER_TARGETS=["192.0.2.1:9100"]
