# Rendered to prometheus.yml by ../render.sh (targets come from .env).
# Ported from k3s infra/prometheus-config; the kubernetes-pods, kube-state-metrics and
# k8s-node-exporter jobs were dropped with the cluster's retirement.
global:
  scrape_interval: 60s
scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]
  - job_name: "node-exporter"
    static_configs:
      - targets: ${NODE_EXPORTER_TARGETS}
  - job_name: "cadvisor"
    static_configs:
      - targets: ${CADVISOR_TARGETS}
  - job_name: "opnsense"
    static_configs:
      - targets: ${OPNSENSE_EXPORTER_TARGETS}
