PUID=1000
PGID=1000
# Local SSD: Navidrome, music app and tv app configs and databases
MEDIA_CONFIG_PATH=/path/to/local/ssd/media
# NAS
MUSIC_LIBRARY_PATH=/path/to/media/Music
MUSIC_INCOMING_PATH=/path/to/downloads/music-incoming
TV_LIBRARY_PATH=/path/to/downloads/TV
MOVIES_LIBRARY_PATH=/path/to/downloads/Movies
YTDL_DOWNLOAD_PATH=/path/to/downloads/youtube
