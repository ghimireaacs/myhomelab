BASE_DOMAIN=your-domain.com
PAPERLESS_SECRET_KEY=random-string
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me
# Local SSD: SQLite database, search index, classifier
PAPERLESS_DATA_PATH=/path/to/local/ssd/paperless/data
# NAS
PAPERLESS_MEDIA_PATH=/path/to/documents/.paperless/media
PAPERLESS_CONSUME_PATH=/path/to/documents/Shared/Inbox/To-Scan
PAPERLESS_EXPORT_PATH=/path/to/documents/Shared/Inbox/Exports
