BASE_DOMAIN=your-domain.com
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on BASE_DOMAIN (the cert-manager token can be reused)
CF_DNS_API_TOKEN=your-cloudflare-token
# Local SSD path for acme.json and access logs
TRAEFIK_DATA_PATH=/path/to/local/ssd/traefik

# Backend hosts used by dynamic/routes.yml
UTILITY_IP=192.0.2.14
GHOSTGPU_IP=192.0.2.11
HOMEASSISTANT_IP=192.0.2.16
NEXTCLOUD_IP=192.0.2.13
PIHOLE_IP=192.0.2.53
TRUENAS_IP=192.0.2.200
PROXMOX_IP=192.0.2.150
