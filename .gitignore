CLAUDE.md
CLAUDE.local.md

# Docker secrets — .env and any variant (.env.local, .env.prod, ...).
# The .env.example templates are re-included below and stay tracked.
**/.env
**/.env.*
!**/.env.example

# Kubernetes secrets.
# This repo is PUBLIC. The glob must catch both the singular and plural
# spellings — `*-secret.yaml` files hold a real Cloudflare API token and
# admin passwords, and an earlier `*-secrets.yaml` pattern silently missed
# them. Templates end in .tmpl/.example, so they are unaffected.
**/*secret*.yaml
**/*secret*.yml
myK8S/.env

# Terraform secrets and state
terraform/*.tfvars
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/.terraform.lock.hcl
terraform/ssh/*.pem
terraform/ssh/bootstrap
terraform/ssh/id_*

# The old wiki lived in a separate repository; docs/ now holds the guide
docs/wiki/

# Claude Code local settings
.claude/

# Thumbnails
Thumbs.db

# Media stack (not portfolio-relevant)
myK8S/media/
docker/ghostmedia/
docker/jellyfin/

# Not ready for public
docker/resume-service/
docker/job-fetcher/CHANGELOG.md

# Rendered from prometheus.yml.tmpl with real targets
docker/monitoring/prometheus/prometheus.yml
